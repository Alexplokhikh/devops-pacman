digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.5, ranksep=0.7, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#555555", fontname="Arial", fontsize=11, margin="0.15,0.1"];
  edge [color="#555555", fontname="Arial", fontsize=9];
  user [label="User / Browser", shape=oval];
  gha [label="GitHub Actions\nOIDC CI/CD"];
  ecr [label="Amazon ECR\ndevops-pacman"];
  subgraph cluster_aws {
    label="AWS — eu-central-1"; color="#999999"; style="rounded";
    lb [label="AWS Load Balancer\nKubernetes Service"];
    subgraph cluster_vpc {
      label="VPC 10.0.0.0/16"; color="#aaaaaa"; style="rounded,dashed";
      subgraph cluster_eks {
        label="Amazon EKS — devops-pacman-eks"; color="#777777"; style="rounded";
        p1 [label="Pac-Man Pod #1\nNode.js / Express"];
        p2 [label="Pac-Man Pod #2\nNode.js / Express"];
        mongo [label="MongoDB StatefulSet\nmongo-0"];
        pvc [label="PVC\n5 GiB / RWO"];
      }
      ebs [label="Amazon EBS gp3\nPersistent Volume", shape=cylinder];
    }
  }
  user -> lb [label="HTTP"];
  lb -> p1;
  lb -> p2;
  p1 -> mongo [label="mongo:27017"];
  p2 -> mongo [label="mongo:27017"];
  mongo -> pvc -> ebs;
  gha -> ecr [label="docker push"];
  ecr -> p1 [label="image pull"];
  ecr -> p2 [label="image pull"];
  gha -> p1 [label="kubectl rollout", style=dashed];
}
