digraph G {
  graph [rankdir=LR, bgcolor="white", pad=0.3, nodesep=0.45, ranksep=0.7, fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f7f7", color="#555555", fontname="Arial", fontsize=11, margin="0.15,0.1"];
  edge [color="#555555", fontname="Arial", fontsize=9];
  dev [label="Developer\ngit push main"];
  gh [label="GitHub Repository"];
  actions [label="GitHub Actions"];
  oidc [label="AWS IAM Role\nOIDC / STS"];
  build [label="Docker Build\nTag = GITHUB_SHA"];
  ecr [label="Amazon ECR\nPush image"];
  kube [label="Update kubeconfig\nAmazon EKS"];
  deploy [label="kubectl set image"];
  rollout [label="kubectl rollout status"];
  app [label="Pac-Man Deployment\n2 replicas", shape=component];
  dev -> gh -> actions;
  actions -> oidc [label="AssumeRoleWithWebIdentity"];
  oidc -> build;
  build -> ecr;
  ecr -> kube [style=dashed, label="image available"];
  actions -> kube;
  kube -> deploy -> rollout -> app;
}
